# ==========================================
# Marcus AI Trading Platform - Environment Config
# ==========================================
# Copy this file to .env and fill in your actual values

# API Keys (NEVER commit .env to version control)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_API_HOST=api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

TUSHARE_TOKEN=your_tushare_token_here
# Tushare API 代理地址（可选，用于无法直连 api.tushare.pro 的环境）
# TUSHARE_API_URL=https://ts.gyzcloud.top/api

# Xueqiu Cookie Token
XUEQIU_TOKEN=xq_a_token=your_xueqiu_token_here
# ArkVol API Key (https://arkvol.com → 头像 → API Key)
ARKVOL_API_KEY=your_arkvol_api_key_here
# ArkVol 登录 Cookie（可选）：funds-greed/ai-summary/tech-hardware-greed 接口需登录态，
# 浏览器登录 arkvol.com 后从 Cookie 中取 access_token_cookie=... 填入
ARKVOL_COOKIE=access_token_cookie=your_arkvol_cookie_here

# Marcus Workspace Path (auto-detected if not set)
# MARCUS_WORKSPACE=/root/.openclaw/workspace-marcus
# MARCUS_WORKSPACE=F:/pythonProject/AITrade/workspace-marcus

# OS Detection for path (auto-detected if not set)
# MARCUS_OS=linux  (for WSL/Linux)
# MARCUS_OS=windows (for Windows)

# Database
DATABASE_URL=postgresql://marcus:password@localhost:5432/marcus_trading
REDIS_URL=redis://localhost:6379/0

# L2（主力行为）门控试运行开关：1=关闭 L2 拦截（仅记录，不排除/不降仓）；0/缺省=启用
# 2026-08-28 起试运行；回退 = 置 0 或删除后重启 backend/worker
ENTRY_L2_DISABLED=0

# 弱市切红利ETF（long_term_pool_monitor）：1=启用；上证收盘<MA20 时清可卖个股→满仓买 515080，
# 转强卖出恢复个股建仓；同方向每日一次，T+1 保护。回退 = 置 0 后重建 worker。
REGIME_DIVIDEND_ETF_ENABLED=0

# Server
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_PORT=3000

# QQ Bot (Official QQ Bot API)
QQ_APP_ID=your_qq_app_id
QQ_APP_SECRET=your_qq_app_secret
QQ_BOT_ENABLED=false
QQ_BOT_RECIPIENT=your_qq_openid

# Pi Server (Node.js AI Agent bridge)
PI_SERVER_URL=http://localhost:3001/chat

# Eastmoney API (cloud servers may be rate-limited, set true to skip)
# SKIP_EASTMONEY=true

# Security
SECRET_KEY=generate_a_random_secret_key_here

# Golden Pit Sector Split (黄金坑板块拆分: 588000/159915 仅作择时指导)
# 以下仅作首次 seed 默认值来源；运行时配置存 PostgreSQL golden_pit_sector_config 表，
# 在黄金坑页面「配置」弹窗修改，保存后即时生效（无需重启）。
# GOLDEN_PIT_SECTOR_SPLIT_ENABLED: false=dry-run 展示选筹; true=板块 ETF 下单(宽基不再直接买入)
GOLDEN_PIT_SECTOR_SPLIT_ENABLED=false
GOLDEN_PIT_SECTOR_TOP_N=2
GOLDEN_PIT_SECTOR_MAX_WEIGHT=0.5
GOLDEN_PIT_SECTOR_COMBO_W_OVS=0.5
GOLDEN_PIT_SECTOR_COMBO_W_MF=0.5
GOLDEN_PIT_SECTOR_OVS_DAYS=120
GOLDEN_PIT_SECTOR_MF_DAYS=5
GOLDEN_PIT_SECTOR_MF_MA_DAYS=20
GOLDEN_PIT_SECTOR_MIN_VALID=4
GOLDEN_PIT_SECTOR_EXIT_DOWN_DAYS=3
