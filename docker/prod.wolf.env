# 生产口径同步（账本 §9.750）—— 上线时并入服务器 .env 即可
#
# 用户 2026-10-07：「将本次回测的配置同步到生产…注意不要将回测的专用配置同步到生产，
#   生产应当能查询所有工具，不存在未来函数的概念」
#
# ★ 只同步**策略/口径**（狼大口径）：
WOLF_WAVE_COND_GATE=1        # §9.746 条件单自动执行也过浪型检查（t_only ⇒ 不追不新建主升）
WOLF_WAVE_COND_AMBUSH=allow  # 埋伏腿放行（用户拍板：wolf_ambush_buy 可以放行）
WOLF_WAVE_COND_OTHER=block   # 未归类买入腿保守拦（可调）
WOLF_T_BUY_CAP_104=1         # §9.748/§9.749 低吸挂价 = min(关键位, 成本×1.04)
WOLF_T_BUY_CAP_PCT=4.0       # 上限 4%（与既有「加仓口径」同值）
WOLF_T_ENTRY_LINES=0         # ★ 2026-10-08 用户拍板「关」：关键位挂单属「生产独有、回测未覆盖」的自设闸 ⇒ 与回测对齐
# ★★ 2026-10-08 用户拍板（第二轮对齐回测）：关掉 6 个「只在生产、回测 pins 未覆盖」的建仓/选股侧闸 ✓
#   依据：jobs/bt_env_pins.sh 未钉这些键 ⇒ 回测走库内默认（全为 0/关）⇒ 生产开着就是"回测没验证过的规则" ✓
WOLF_LINE_REGIME_GATE=0      # 白线在上∧缩量→没有买点（docstring 自称"影子"，库内默认 0）
WOLF_STEP_REFILL=0           # C6 分步回补条件（"影子"，库内默认 0）
WOLF_MA_LINE_ENTRY=0         # 买腿挂 13/34/60/144 均线价（"影子"，库内默认 0）
WOLF_ETF_VOL_GATE=0          # ETF 波动下限（库内默认 0）
WOLF_FUND_GATE_FAILCLOSED=0  # 资金/量能取数失败时由 fail-closed 改回 fail-open（库内默认 1 ⇒ **必须显式写 0**）
# ★ 同时删除 3 个键（2026-10-08）：
#   WOLF_JUDGE_CATALYST / WOLF_MAINLINE_GATE_STEP —— 全仓库**无任何读取处**（死键/历史残留）
#   WOLF_TREND_VOL_RATIO —— 数值（生产 1.0 vs 库内默认 1.2）⇒ 删行即回到默认，与回测一致
WOLF_WAVE_OP_GATE=0          # 明确关掉 op-gate（按狼大原判据：只看指数大级别破位）
#
# ✗ **绝不同步**（回测专用 / 未来函数相关）：
#   BT_*（BT_ASOF_DAY/BT_ASOF_STATE/BT_NET_OFFLINE/BT_CARRY_STATE/BT_AGENT_LOOP…）
#   WOLF_ADJ_PRICE（前复权价空间）／WOLF_SIM_DAY／WOLF_HIST_*／BT_DASH*／QT_*／REPLAY/SIM 等
#   ⇒ 生产是**当日实时**：没有 as-of、没有"防未来函数"这套东西
#
# ★ 工具可用性（上线必查）：
#   桥的语义（docker/dsh/bridge/lib/index.js:79-98）：
#     · 白名单文件**不存在** ⇒ 全量注册（全工具）✓ ← 生产应为这一档
#     · 文件存在且为空 ⇒ 只注册 0 个 ✗（回测用它做隔离）
#   ⇒ compose 里的 `bt_tools_allow.txt` 只读挂载**已拆除**（§9.750）
#   ⇒ 回测侧改用 `bash jobs/bt_tools_allow.sh off|all` 在**运行时**切换（回测专用）

# §9.761 ✓（用户拍板「开」✓）：生产开启「排除 光伏/商业航天 行业票」
#   依据 ✓：用户口径「否能直接去掉商业航天和光伏相关行业的票」✓，口径：光伏（含逆变器/硅料硅片/光伏发电）+ 商业航天（申万航天装备 ∪ 概念含「航天/卫星/宇航」）
#   生产无需缓存 ✓（它实时直接读当日申万✓；缓存仅回测/离线需要✓）
#   回滚 ✓：删掉本行（或改 0）⇒ 重建 backend/worker 即可✓
WOLF_UNIVERSE_EXCLUDE=1
# ★ 账本 §9.762 ✓：生产已开「排除光伏/商业航天」⇒ 必须让它找得到申万缓存 ✓
#   容器内路径（compose 锚点已设 ✓，此处同步一份便于部署一致 ✓）
WOLF_UNIVERSE_EXCLUDE=1
WOLF_SW_CACHE=/app/data/sw_members_cache.json

# ★★ 账本 §9.764 ✓：agent 判质地（生产开 ✓；代码默认 0 ⇒ 未配 env 部署不变 ✓）
WOLF_QUALITY_JUDGE=1
WOLF_QUALITY_JUDGE_TIMEOUT=120
WOLF_QUALITY_JUDGE_CACHE_TTL_H=24


