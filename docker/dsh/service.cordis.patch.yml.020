# Marcus service profile patch — 无 GUI 的常驻 DSH 服务（替代 Pi Server）
# 叠加在 dsh-base 之上：插入 webserver（host 0.0.0.0）与 code-runtime，
# dsh-marcus-bridge 插件在此注册 /chat /health /reset 端点。

- id: system-prompt
  config:
    persona: >-
      You are a coding agent powered by the {{model}} model. Your working directory is {{cwd}}.

# 共享 HMR 行关闭（服务端无浏览器）
- id: hmr
  disabled: true

- id: tools
  config:
    # 与 headless 一致：Code Mode 作为核心执行能力
    mode: !!js process.env.DSH_TOOLS_MODE

# 文件沙箱：桥接会话默认 workspace-write（工作区 /app + /tmp 可写），
# 覆盖 dsh-base 的 read-only 兜底；审批保持 ask（headless 下越权升级会失败关闭，属预期安全行为）
- id: sandbox-policy
  config:
    mode: workspace-write
    workspaceRoot: /app

# web_search：走 OpenCode 网关（Anthropic 兼容 /v1/messages + web_search_20250305 server tool，已实测可用），
# key 复用网关 key（DEEPSEEK_API_KEY，服务器 .env 已注入，无需新 key）；
# 端点默认网关，可用 DEEPSEEK_SEARCH_BASE_URL 覆盖（如切回 DeepSeek 官方 https://api.deepseek.com/anthropic/v1）
- id: web-search-deepseek
  config:
    apiKeyEnv: DEEPSEEK_API_KEY
    baseURL: !!js process.env.DEEPSEEK_SEARCH_BASE_URL ?? 'https://opencode.ai/zen/go/v1'

- insert:

# ★★ 2026-11-02 ✓（生产告警根因）：provider 适配器**不用自己插条目** ✗ —— dsh-base 已经挂了 ✓
#   `dsh --dump-config` 实测 base 组合树里本来就有（本文件不再重复插入 ✓）：
#     · id: llm-deepseek         name: '@deepseek-ai/dsh-llm-deepseek-api-key' ← 注册 provider deepseek-official ✓
#     · id: llm-deepseek-account name: '@deepseek-ai/dsh-llm-deepseek-account'  ← 账号凭证通道 ✓
#     · 传输包 @deepseek-ai/dsh-llm-deepseek **只导出库**（Config/DeepSeekAdapter/
#       registerDeepSeekProvider）**没有 apply / default** ✗ ⇒ 不能当 cordis entry 挂 ✓
#   旧写法 ✗ 正好踩中这两点：
#     ① 用同 id 的 `llm-deepseek` 条目把 base 那条 **覆盖成传输包** ✗
#        ⇒ cordis 抛 `invalid plugin, expect function or object with an "apply" method` ✗
#        ⇒ 每次启动打 `dsh: warning: 1 entry did not activate` + `llm-deepseek … failed to import` ✗
#     ② 再另起 `llm-deepseek-key` 重复挂一次 api-key 插件 ✗ ⇒ 一旦去掉①立刻撞
#        `LlmError: configurable provider "deepseek-official" is already declared` ✗
#   ⇒ 正解：**只 patch base 那条的 config**（同 id、**不要写 name** ✓），不插新条目 ✓
- id: llm-deepseek
  config:
    apiKeyEnv: DEEPSEEK_API_KEY
    # ★ 账本 §9.696 ✓（用户「123都加上」✓）：按适配器 README 的字段表降档 ✗
    #   实测 ✓：一次回合 370 秒 = 上游每次 ~60 秒失败 × **重试 6 次**（assistant/attempt:6）
    #     · reasoningEffort 默认 **high** ⇒ 降 **low** ✓（模型是推理模型 ✓）
    #     · streamIdleTimeoutMs 默认 **300000（5 分钟）** ⇒ 降 **60000** ✓
    #     · retryPolicy 默认「normal, **5 retries**」⇒ **maxRetries: 1** ✓（执行器 dsh-llm-retry ✓）
    #   ⇒ 单次回合最坏 60~120 秒 ✓（而非 370 ✗）⇒ 排队者不再集体 420 秒超时 ✓
    reasoningEffort: low
    streamIdleTimeoutMs: 60000
    # ★ §9.696 修正 ✓：schema 校验报错原文 ⇒
    #   $.retryPolicy expected { mode: "normal", maxRetries?: number, … }
    #   ⇒ **mode 是必填** ✗（我第一版漏了 ⇒ ValidationError ✓）
    retryPolicy:
      mode: normal
      maxRetries: 1
    # ★ 账本 §9.690 补2 ✓：**endpoint 也必须给** ✗ —— 只给 apiKeyEnv 会在加载时
    #   抛 `TypeError: Invalid URL`（实测 ✓，插件加载失败 ⇒ provider 未注册 ⇒ NO_ADAPTER ✓）
    #   代码里读的字段名实测是 ⇒ `config.baseURL` ✓
    baseURL: !!js process.env.DEEPSEEK_BASE_URL ?? 'https://api.deepseek.com/anthropic'

- insert:

    # 常驻 HTTP 服务器：暴露 0.0.0.0 供 compose 网络内其他容器访问

    - id: webserver
      name: '@deepseek-ai/dsh-host-webserver'
      config:
        host: '0.0.0.0'
        port: !!js parseInt(process.env.PI_SERVER_PORT || '3001', 10)

    # Marcus 桥接插件：POST /chat /health /reset（Pi Server 兼容契约）
    - id: dsh-marcus-bridge
      name: dsh-dsh-marcus-bridge
